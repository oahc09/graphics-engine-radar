# ══════════════════════════════════════════════════════════════════
# Graphics Engine Radar — 统一配置文件(唯一需要修改的配置)
# 复制为 .env 后按需修改;后端(Python)与前端(Next.js)都从这里读取。
# 不改任何项也可以运行(内嵌数据库模式: uv run python scripts/embedded_db.py start)
# ══════════════════════════════════════════════════════════════════

# ── 1. 数据库 ──────────────────────────────────────────────────────
# 推荐:不填,使用内嵌数据库(scripts/embedded_db.py 会自动写入这一行,
# 数据存放在 ./data/pgdata,可用 GRADAR_DATA_DIR 改位置)。
# 也可指向外部 PostgreSQL(需 pgvector):
#   本机 brew:    localhost:5432    Docker compose: localhost:5433
# DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5432/radar

# 内嵌数据库数据目录(可选)
# GRADAR_DATA_DIR=

# ── 2. 端口(可选,默认 8300/8301)────────────────────────────────
# API_PORT=8300
# WEB_PORT=8301

# ── 3. GitHub 采集凭证 ────────────────────────────────────────────
# 不填 = 匿名限流 60 次/小时。推荐填 gh auth token 的输出。
# GITHUB_TOKEN=

# ── 4. 大模型(LLM)接入 ──────────────────────────────────────────
# 不配置任何 LLM 时,管线以确定性启发式分析器运行(零成本可用)。
# 三种方式任选其一:

# 方式 1(推荐,零成本):Claude Code CLI,复用本机已登录的 claude
# LLM_PROVIDER=claude-cli
# LLM_MODEL=                       # 留空 = CLI 默认;如 claude-sonnet-4-5

# 方式 2(零成本):Codex CLI,复用本机已登录的 codex(ChatGPT 账号)
# LLM_PROVIDER=codex-cli
# LLM_MODEL=                       # 留空 = CLI 默认;如 gpt-5.1-codex

# 方式 3:OpenAI 兼容 HTTP API。换供应商只改 BASE 和 MODEL:
#   OpenAI     https://api.openai.com/v1            gpt-4o-mini
#   Anthropic  https://api.anthropic.com/v1         claude-sonnet-4-5
#   OpenRouter https://openrouter.ai/api/v1         anthropic/claude-sonnet-4.5
#   DeepSeek   https://api.deepseek.com/v1          deepseek-chat
#   通义       https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   智谱/Z.ai  https://open.bigmodel.cn/api/paas/v4 glm-4.6
#   Kimi       https://api.moonshot.cn/v1           kimi-k2
#   本地 Ollama http://localhost:11434/v1(LLM_API_KEY=local)  qwen2.5:14b
# LLM_PROVIDER=openai
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# 高级:限定允许调用 LLM 的阶段(逗号分隔,留空 = 全部)。
# 可选: candidate_detection,event_clustering,technical_analysis,
#       topic_mapping,impact_evaluation,digest
# 建议(候选检测量大且规则已够用,LLM 留给高价值阶段):
# LLM_STAGES=technical_analysis,impact_evaluation,digest

# LLM/CLI 单次调用超时(秒)
# LLM_CLI_TIMEOUT=240

# ── 5. Web → API 代理(一般不用改)───────────────────────────────
# 默认自动指向 http://127.0.0.1:${API_PORT}
# API_PROXY_TARGET=
# NEXT_PUBLIC_API_BASE=

# ── 6. 监控范围(不在本文件,改这里)──────────────────────────────
# 监控对象/主题/来源是 YAML 配置: config/objects/ config/topics/
# 由 tools/gen_configs.py 生成,改后执行:
#   uv run python tools/gen_configs.py && uv run radar-collector sync-config
