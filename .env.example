# Graphics Engine Radar environment example
# Copy to .env and fill in what you need.
#
# EASIEST: skip DATABASE_URL entirely and use the embedded database
# (scripts/embedded_db.py writes this line for you):
#   uv run python scripts/embedded_db.py start
# It bundles PostgreSQL+pgvector via pgserver; data lives in ./data/pgdata.

# PostgreSQL (brew services: postgresql@17 on port 5432; docker-compose maps 5433)
DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5433/radar

# ─────────────────────────── LLM 接入 ───────────────────────────
# 不配置任何 LLM 时管线以确定性启发式分析器运行(零成本,可日常使用)。
# 三种接入方式任选其一:

# 方式 1(推荐,零成本):Claude Code CLI。要求已安装并登录 `claude` 命令。
#   LLM_PROVIDER=claude-cli
#   LLM_MODEL=                        # 留空 = CLI 默认模型;或如 claude-sonnet-4-5

# 方式 2(零成本):Codex CLI。要求已安装并登录 `codex` 命令(ChatGPT 账号)。
#   LLM_PROVIDER=codex-cli
#   LLM_MODEL=                        # 留空 = CLI 默认;或 gpt-5.1-codex 等

# 方式 3:OpenAI 兼容 HTTP API(OpenAI / DeepSeek / 通义 / GLM / OpenRouter / 本地 Ollama…)
#   LLM_PROVIDER=openai
#   LLM_API_BASE=https://api.openai.com/v1       # 换供应商只改这一行
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini

# 高级:限制哪些阶段允许调用 LLM(逗号分隔;留空 = 全部阶段)。
# 可选阶段: candidate_detection,event_clustering,technical_analysis,
#           topic_mapping,impact_evaluation,digest
# 推荐只在贵阶段用 LLM(候选检测量大,规则已够用):
#   LLM_STAGES=technical_analysis,impact_evaluation,digest

# CLI 超时(秒;claude/codex 单次调用可能较慢)
LLM_CLI_TIMEOUT=240

# GitHub token (gh auth token). Without it: 60 req/h core rate limit.
GITHUB_TOKEN=

# Web
API_PROXY_TARGET=http://127.0.0.1:8300
