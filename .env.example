# Database. For Compose, keep PostgreSQL private and use the service DNS name.
# Use URL-encoding for special characters in the password.
POSTGRES_USER=radar
POSTGRES_PASSWORD=
POSTGRES_DB=radar
DATABASE_URL=postgresql+psycopg://radar:<url-encoded-password>@postgres:5432/radar

# Optional GitHub enhancement. Empty = anonymous API rate limits.
GITHUB_TOKEN=

# Default is the real deterministic heuristic path; no paid LLM is invoked
# while LLM_API_KEY is empty and no CLI provider is explicitly selected.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=

# Admin API is fail-closed. Leave disabled for the default public-read deployment.
# Enabling it also requires a non-empty server-side Bearer token; never use NEXT_PUBLIC_*.
ENABLE_ADMIN_API=false
ADMIN_API_TOKEN=

# Complete-pipeline scheduler.
PIPELINE_INTERVAL_SECONDS=3600
PIPELINE_TIMEOUT_SECONDS=3600
PIPELINE_MAX_RETRIES=1
PIPELINE_RETRY_DELAY_SECONDS=300
PIPELINE_RUN_ON_START=true
SCHEDULER_HEALTH_GRACE_SECONDS=600

# Web is bound to loopback by default until a TLS reverse proxy/public target is authorized.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8301
